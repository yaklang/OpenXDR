table inet openxdr_registry_guard {
 chain ingress {
  type filter hook prerouting priority -110; policy accept;
  iifname "lo" accept
  # 示例地址：换成已核实的 Registry 消费者（本机与拉取方），新增消费者先确认用途再加
  fib daddr type local tcp dport 5000 ip saddr { 10.0.0.189, 10.0.0.192, 10.0.0.193 } counter accept
  fib daddr type local tcp dport 5000 counter drop
 }
}
