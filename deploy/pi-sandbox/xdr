#!/bin/bash
# xdr：沙箱里操作受管主机与平台数据的唯一方式。经 unix socket 交给沙箱桥，再由平台判权、审批、审计；
# 沙箱本身不持有平台凭据，也访问不到平台网络。这里只做参数整理与输出格式化。
set -euo pipefail
SOCKET=${XDR_SOCKET:-/tmp/xdr/xdr.sock}
CONTEXT=${XDR_CONTEXT:-/tmp/xdr/context.json}
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

call() { # 工具名 参数JSON
  local resp
  resp=$(/usr/bin/curl -sS --max-time 1800 --unix-socket "$SOCKET" -H 'Content-Type: application/json' \
    -d "$(jq -cn --arg n "$1" --argjson a "$2" '{name:$n,args:$a}')" http://xdr/tool) || { echo "xdr 通道不可用" >&2; exit 2; }
  if jq -e 'has("error")' >/dev/null <<<"$resp"; then jq -r .error <<<"$resp" >&2; exit 1; fi
  jq -r .output <<<"$resp"
}

context() { cat "$CONTEXT"; }

text() { # 参数原样，或 - 表示从 stdin 读（heredoc 传命令和 SQL，不用处理引号嵌套）
  if [ "$1" = - ]; then cat; else printf '%s' "$1"; fi
}

require_uuid() { # 字段名 值：校验并转小写 UUID
  local label=$1 val=${2:-}
  [[ $val =~ $UUID_RE ]] || { echo "$label 必须是有效的 UUID：$val" >&2; exit 2; }
  printf '%s' "${val,,}"
}

parse_uuid_csv() { # 字段名 逗号分隔UUID列表 最大条数 已有JSON数组
  local label=$1 raw=${2:-} max=$3 arr=${4:-'[]'} item
  [ -n "$raw" ] || { echo "$label 不能为空" >&2; exit 2; }
  local IFS=,
  read -r -a items <<<"$raw"
  [ "${#items[@]}" -gt 0 ] || { echo "$label 不能为空" >&2; exit 2; }
  for item in "${items[@]}"; do
    item=$(require_uuid "$label" "$item") || exit $?
    arr=$(jq -c --arg u "$item" '. + [$u]' <<<"$arr")
  done
  local count
  count=$(jq 'length' <<<"$arr")
  [ "$count" -le "$max" ] || { echo "$label 最多 $max 条，收到 $count 条" >&2; exit 2; }
  printf '%s' "$arr"
}

host_id() { # 主机名或资产 ID
  if [[ $1 =~ $UUID_RE ]]; then echo "${1,,}"; return; fi
  local id; id=$(context | jq -r --arg h "$1" '.assets[] | select(.hostname==$h) | .id' | head -1)
  [ -n "$id" ] || { echo "本组没有主机 $1，用 xdr hosts 查看" >&2; exit 1; }
  echo "$id"
}

usage() {
  cat <<'U'
用法：
  xdr hosts                              本组主机（主机名、角色、重要程度、区域）
  xdr context                            平台给的组内数据：资产、规则名、待办、交来的事件（JSON）
  xdr exec <主机名> <命令|-> [超时秒] [--finding <待办id>]  在主机上执行命令（首行含指令 id；同主机多条待办执行写修复时用 --finding 指定 context.subjects 里的待办 id）；- 表示从 stdin 读命令
  xdr command-status <指令 id>           只读查询已有指令的最新回执（exec 超时或状态 unknown 时先查，禁止自动重试）
  xdr verify-command <指令 id> <effective|ineffective|inconclusive> <telemetry_post_action|exec_probe|receipt_correlation|context_only|ai_investigation> <预期效果> <实测证据> [--events <事件id,...>] [--context-events <事件id,...>]  记录指令效果验证
  xdr sql [--json] <只读SQL|->           查本组只读视图，默认 TSV（首行列名）；--json 每行一个 JSON 对象，
                                         jsonb 列保持原样，适合交给 jq；- 表示从 stdin 读 SQL
  xdr track <主机名> <key> <low|medium|high> <open|resolved|withdrawn> <标题> <详情|-> [--next-step <下一步>] [--blocker <阻塞原因>] [--evidence <指令id,...>]  登记或复查待办；--evidence 传 1–5 个本轮独立只读复查指令 UUID（严禁单凭修复命令 exit=0 关单）；--blocker 支持 policy_required / maintenance_window_required / manual_business_decision / legacy_decommission_confirm / external_dependency / permission / unsupported
  xdr ignore <主机名> <key> <理由>        用户在对话里明确要求时忽略待办（同待办页人工忽略；仅组管理员发起的对话可用）
  xdr identify <主机名> <tcp/端口|udp/端口> <high|medium|low> <服务名> <依据与结论>
  xdr egress <主机名> <公网地址> <high|medium|low> <用途> <依据与结论>
  xdr memories                           本组长期记忆（实时，含本轮刚记下的；id、来源、主机、内容、待复核说明）
  xdr remember [主机名|-] <内容>          记下以后用得上的环境事实（- 表示整个组）
  xdr forget <记忆 id>                   删掉过时的 AI 记忆
  xdr suppress <主机名> <规则 id> <理由> <天数> <条件>...
                                         提议抑制反复误报的命中（AI 审计员评审通过后生效）。条件 1–3 个，AND：
                                         字段=值（等于）、字段~=值（包含）、字段$=值（结尾），字段为事件体 dot path
  xdr propose-close <事件 id> <false_positive|closed> <结案说明> [报告 id]
                                         给事件提结案建议，人在事件页一键采纳
  xdr report <标题> <一句话结论> <Markdown 文件|-> [级别]
                                         保存最终报告；- 表示从 stdin 读正文；正文按 ## 结论 / ## 需要人处理 / ## 未验证 等节写；
                                         级别 ok（无需处理，只存档）/ attention（默认）/ urgent
U
}

need() { # 子命令 最少参数个数 实际参数...：不够时只打印这个子命令那一行用法，并指出缺的是哪个参数
  local sub=$1 min=$2 line params; shift 2
  [ $# -ge "$min" ] && return
  line=$(usage | grep -E "^  xdr $sub( |\$)" | sed -E 's/^ +//; s/ {2,}.*//')
  mapfile -t params < <(grep -oE '<[^>]+>' <<<"$line")
  echo "用法：$line" >&2
  echo "缺少参数 ${params[$#]:-}：需要至少 $min 个，收到 $# 个（带空格的参数整个用引号括起来）" >&2
  exit 2
}

no_extra() { # 子命令 最多参数个数 实际参数个数
  local sub=$1 max=$2 actual=$3
  [ "$actual" -le "$max" ] && return
  echo "xdr $sub 参数过多：最多 $max 个位置参数，收到 $actual 个（带空格的参数整个用引号括起来）" >&2
  exit 2
}

cmd=${1:-}; shift || true
case "$cmd" in
  hosts)
    no_extra "$cmd" 0 "$#"
    context | jq -r '.assets[] | [.hostname, (.role // "-"), (.criticality // "-" | tostring), (.zone.name // .zone.kind), (.os // "-")] | @tsv' | column -t -s $'\t' ;;
  context)
    no_extra "$cmd" 0 "$#"
    context | jq . ;;
  exec)
    pos=()
    finding_id=""
    has_finding=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --finding|--finding-id|--finding_id)
          [ $# -ge 2 ] || { echo "缺少 $1 参数值" >&2; exit 2; }
          finding_id=$(require_uuid "finding_id" "$2") || exit $?
          has_finding=1
          shift 2 ;;
        --finding=*|--finding-id=*|--finding_id=*)
          finding_id=$(require_uuid "finding_id" "${1#*=}") || exit $?
          has_finding=1
          shift ;;
        -)
          pos+=("-"); shift ;;
        --*)
          echo "xdr exec 未知选项：$1" >&2; exit 2 ;;
        *)
          pos+=("$1"); shift ;;
      esac
    done
    need "$cmd" 2 "${pos[@]}"
    no_extra "$cmd" 3 "${#pos[@]}"
    timeout=${pos[2]:-60}
    [[ $timeout =~ ^[0-9]+$ ]] && [ "$timeout" -ge 1 ] && [ "$timeout" -le 300 ] || { echo "timeout 必须是 1–300 的整数秒：$timeout" >&2; exit 2; }
    host=$(host_id "${pos[0]}")
    cmd_text=$(text "${pos[1]}")
    payload=$(jq -cn --arg h "$host" --arg c "$cmd_text" --argjson t "$timeout" \
      --argjson hf "$has_finding" --arg fid "$finding_id" \
      '{host:$h,cmd:$c,timeout:$t} + (if $hf == 1 then {finding_id:$fid} else {} end)')
    out=$(call exec "$payload")
    jq -r '"[id=\(.id // "-") status=\(.status) exit=\(.exit_code // "-")\(if .truncated then " truncated" else "" end)]", (.stdout // ""), (if (.stderr // "") != "" then "[stderr]\n" + .stderr else empty end)' <<<"$out" ;;
  command-status|command_status)
    need "command-status" 1 "$@"
    no_extra "command-status" 1 "$#"
    cid=$(require_uuid "command" "$1")
    call command_status "$(jq -cn --arg c "$cid" '{command:$c}')" ;;
  verify-command|verify_command)
    pos=()
    events='[]'
    has_events=
    context_events='[]'
    has_context_events=
    while [ $# -gt 0 ]; do
      case "$1" in
        --events|--event-ids|--event_ids)
          [ $# -ge 2 ] || { echo "缺少 $1 参数值" >&2; exit 2; }
          events=$(parse_uuid_csv "event_ids" "$2" 20 "$events")
          has_events=1
          shift 2 ;;
        --events=*|--event-ids=*|--event_ids=*)
          events=$(parse_uuid_csv "event_ids" "${1#*=}" 20 "$events")
          has_events=1
          shift ;;
        --context-events|--context-event-ids|--context_event_ids)
          [ $# -ge 2 ] || { echo "缺少 $1 参数值" >&2; exit 2; }
          context_events=$(parse_uuid_csv "context_event_ids" "$2" 20 "$context_events")
          has_context_events=1
          shift 2 ;;
        --context-events=*|--context-event-ids=*|--context_event_ids=*)
          context_events=$(parse_uuid_csv "context_event_ids" "${1#*=}" 20 "$context_events")
          has_context_events=1
          shift ;;
        --*)
          echo "xdr verify-command 未知选项：$1" >&2; exit 2 ;;
        *)
          pos+=("$1"); shift ;;
      esac
    done
    need "verify-command" 5 "${pos[@]}"
    no_extra "verify-command" 5 "${#pos[@]}"
    cid=$(require_uuid "command" "${pos[0]}")
    outcome=${pos[1]}
    case "$outcome" in effective|ineffective|inconclusive) ;; *) echo "outcome 必须是 effective / ineffective / inconclusive：$outcome" >&2; exit 2 ;; esac
    method=${pos[2]}
    case "$method" in telemetry_post_action|exec_probe|receipt_correlation|context_only|ai_investigation) ;; *) echo "method 必须是 telemetry_post_action / exec_probe / receipt_correlation / context_only / ai_investigation：$method" >&2; exit 2 ;; esac
    expected=$(text "${pos[3]}")
    observed=$(text "${pos[4]}")
    [ -n "$expected" ] && [ -n "$observed" ] || { echo "expected 与 observed 不能为空" >&2; exit 2; }
    payload=$(jq -cn --arg c "$cid" --arg o "$outcome" --arg m "$method" --arg ex "$expected" --arg ob "$observed" \
      --argjson he "${has_events:-0}" --argjson ev "$events" \
      --argjson hce "${has_context_events:-0}" --argjson cev "$context_events" \
      '{command:$c,outcome:$o,method:$m,expected:$ex,observed:$ob}
      + (if $he == 1 then {event_ids:$ev} else {} end)
      + (if $hce == 1 then {context_event_ids:$cev} else {} end)')
    call verify_command "$payload" ;;
  sql)
    json=; [ "${1:-}" = --json ] && { json=1; shift; }
    need "$cmd" 1 "$@"
    no_extra "$cmd" 1 "$#"
    out=$(call query "$(jq -cn --arg s "$(text "$1")" '{sql:$s}')")
    if [ -n "$json" ]; then
      # TSV 会把反斜杠再转义一层，jsonb 列就解析不回来了；JSON 行原样保留嵌套结构
      jq -c '.columns as $c | .rows[] | [$c, .] | transpose | map({(.[0]): .[1]}) | add // {}' <<<"$out"
      if jq -e .truncated >/dev/null <<<"$out"; then echo "[truncated] 结果被截断（最多 200 行、8 KiB），只是部分数据" >&2; fi
    else
      jq -r '(.columns | @tsv), (.rows[] | map(if type == "object" or type == "array" then tojson else (. // "" | tostring) end) | @tsv), (if .truncated then "[truncated]" else empty end)' <<<"$out"
    fi ;;
  track)
    pos=()
    next_step=""
    has_next=0
    blocker=""
    has_blocker=0
    evidence='[]'
    has_evidence=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --next-step|--next_step)
          [ $# -ge 2 ] || { echo "缺少 $1 参数值" >&2; exit 2; }
          [ -n "${2//[[:space:]]/}" ] || { echo "next_step 不能为空" >&2; exit 2; }
          next_step=$2; has_next=1; shift 2 ;;
        --next-step=*|--next_step=*)
          val=${1#*=}
          [ -n "${val//[[:space:]]/}" ] || { echo "next_step 不能为空" >&2; exit 2; }
          next_step=$val; has_next=1; shift ;;
        --blocker)
          [ $# -ge 2 ] || { echo "缺少 $1 参数值" >&2; exit 2; }
          case "$2" in policy_required|maintenance_window_required|manual_business_decision|legacy_decommission_confirm|external_dependency|permission|unsupported) ;; *) echo "blocker 必须是 policy_required / maintenance_window_required / manual_business_decision / legacy_decommission_confirm / external_dependency / permission / unsupported：$2" >&2; exit 2 ;; esac
          blocker=$2; has_blocker=1; shift 2 ;;
        --blocker=*)
          val=${1#*=}
          case "$val" in policy_required|maintenance_window_required|manual_business_decision|legacy_decommission_confirm|external_dependency|permission|unsupported) ;; *) echo "blocker 必须是 policy_required / maintenance_window_required / manual_business_decision / legacy_decommission_confirm / external_dependency / permission / unsupported：$val" >&2; exit 2 ;; esac
          blocker=$val; has_blocker=1; shift ;;
        --evidence|--evidence-commands|--evidence_commands)
          [ $# -ge 2 ] || { echo "缺少 $1 参数值" >&2; exit 2; }
          evidence=$(parse_uuid_csv "evidence_commands" "$2" 5 "$evidence")
          has_evidence=1; shift 2 ;;
        --evidence=*|--evidence-commands=*|--evidence_commands=*)
          evidence=$(parse_uuid_csv "evidence_commands" "${1#*=}" 5 "$evidence")
          has_evidence=1; shift ;;
        -)
          pos+=("-"); shift ;;
        --*)
          echo "xdr track 未知选项：$1" >&2; exit 2 ;;
        *)
          pos+=("$1"); shift ;;
      esac
    done
    need "$cmd" 6 "${pos[@]}"
    no_extra "$cmd" 6 "${#pos[@]}"
    host=$(host_id "${pos[0]}")
    key=${pos[1]}
    [[ $key =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || { echo "key 只能是小写字母、数字与 . _ -，不超过 64 位：$key" >&2; exit 2; }
    sev=${pos[2]}
    case "$sev" in low|medium|high) ;; *) echo "severity 必须是 low / medium / high：$sev" >&2; exit 2 ;; esac
    st=${pos[3]}
    case "$st" in open|resolved|withdrawn) ;; *) echo "status 必须是 open / resolved / withdrawn：$st" >&2; exit 2 ;; esac
    title=${pos[4]}
    detail=$(text "${pos[5]}")
    payload=$(jq -cn --arg h "$host" --arg k "$key" --arg sv "$sev" --arg st "$st" --arg t "$title" --arg d "$detail" \
      --argjson hn "$has_next" --arg ns "$next_step" \
      --argjson hb "$has_blocker" --arg bl "$blocker" \
      --argjson he "$has_evidence" --argjson ev "$evidence" \
      '{host:$h,key:$k,severity:$sv,status:$st,title:$t,detail:$d}
      + (if $hn == 1 then {next_step:$ns} else {} end)
      + (if $hb == 1 then {blocker:$bl} else {} end)
      + (if $he == 1 then {evidence_commands:$ev} else {} end)')
    call track "$payload" ;;
  ignore)
    need "$cmd" 3 "$@"
    no_extra "$cmd" 3 "$#"
    host=$(host_id "$1")
    call ignore "$(jq -cn --arg h "$host" --arg k "$2" --arg r "$3" '{host:$h,key:$k,reason:$r}')" ;;
  identify)
    need "$cmd" 5 "$@"
    no_extra "$cmd" 5 "$#"
    host=$(host_id "$1")
    call identify "$(jq -cn --arg h "$host" --arg p "$2" --arg r "$3" --arg n "$4" --arg note "$5" '{host:$h,port:$p,risk:$r,name:$n,note:$note}')" ;;
  egress)
    need "$cmd" 5 "$@"
    no_extra "$cmd" 5 "$#"
    host=$(host_id "$1")
    call egress "$(jq -cn --arg h "$host" --arg ip "$2" --arg r "$3" --arg n "$4" --arg note "$5" '{host:$h,ip:$ip,risk:$r,name:$n,note:$note}')" ;;
  memories)
    no_extra "$cmd" 0 "$#"
    call memories '{}' | jq -r '.memories[] | [.id, .source, (.host // "-"), .content, (if .review then "【待复核】" + .review else "" end)] | @tsv' ;;
  remember)
    if [ $# -eq 2 ]; then
      host=""; [ "$1" = "-" ] || host=$(host_id "$1")
      call remember "$(jq -cn --arg h "$host" --arg c "$2" 'if $h == "" then {content:$c} else {host:$h,content:$c} end')"
    elif [ $# -eq 1 ]; then
      call remember "$(jq -cn --arg c "$1" '{content:$c}')"
    else
      need "$cmd" 1 "$@"
      no_extra "$cmd" 2 "$#"
    fi ;;
  forget)
    need "$cmd" 1 "$@"
    no_extra "$cmd" 1 "$#"
    mid=$(require_uuid "id" "$1")
    call forget "$(jq -cn --arg i "$mid" '{id:$i}')" ;;
  suppress)
    need "$cmd" 5 "$@"
    host=$(host_id "$1"); rule=$2; why=$3; days=$4; shift 4
    [[ $days =~ ^[0-9]+$ ]] || { echo "天数必须是正整数：$days" >&2; exit 2; }
    conds='[]'
    for c in "$@"; do
      if [[ $c =~ ^([a-z0-9_.]+)(\$=|~=|=)(.+)$ ]]; then
        case ${BASH_REMATCH[2]} in '$=') op=endswith ;; '~=') op=contains ;; *) op=equals ;; esac
        conds=$(jq -c --arg f "${BASH_REMATCH[1]}" --arg o "$op" --arg v "${BASH_REMATCH[3]}" '. + [{field:$f,op:$o,value:$v}]' <<<"$conds")
      else
        echo "条件格式不对：$c（字段=值、字段~=值、字段\$=值）" >&2; exit 2
      fi
    done
    call suppress "$(jq -cn --arg h "$host" --arg r "$rule" --arg why "$why" --argjson d "$days" --argjson c "$conds" '{host:$h,rule_id:$r,reason:$why,days:$d,conditions:$c}')" ;;
  propose-close)
    need "$cmd" 3 "$@"
    no_extra "$cmd" 4 "$#"
    iid=$(require_uuid "incident" "$1")
    rid=""
    [ -z "${4:-}" ] || rid=$(require_uuid "report" "$4")
    call propose_close "$(jq -cn --arg i "$iid" --arg s "$2" --arg n "$3" --arg r "$rid" '{incident:$i,status:$s,note:$n} + (if $r == "" then {} else {report:$r} end)')" ;;
  report)
    need "$cmd" 3 "$@"
    no_extra "$cmd" 4 "$#"
    [ "$3" = - ] || [ -f "$3" ] || { echo "正文文件不存在：$3（正文写进文件，或用 - 从 stdin 读）" >&2; exit 2; }
    if [ "$3" = - ]; then body=$(jq -Rs . ); else body=$(jq -Rs . <"$3"); fi # 正文来自文件，或 - 表示 stdin
    call report "$(jq -cn --arg t "$1" --arg s "$2" --argjson m "$body" --arg l "${4:-}" '{title:$t,summary:$s,markdown:$m} + (if $l == "" then {} else {level:$l} end)')" ;;
  *) usage; [ -z "$cmd" ] || exit 2 ;;
esac
