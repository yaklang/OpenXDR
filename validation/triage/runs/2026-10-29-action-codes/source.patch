@@ -0,0 +1,45 @@
+package triage
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestCollectionEvidencePreservesUnknownAndSnapshotTime(t *testing.T) {
+	for _, raw := range []string{"", "null", "{}", `{"receivedAt":"broken"}`, `{"capabilities":{"process":{"state":"active"}}}`} {
+		facts := collectionEvidence(json.RawMessage(raw))
+		if len(facts) != 1 || facts["collection_status"] != "unknown" {
+			t.Fatalf("%s: %v", raw, facts)
+		}
+	}
+	facts := collectionEvidence(json.RawMessage(`{"receivedAt":"2020-01-01T00:00:00Z","capabilities":{"process":{"state":"degraded","path":"poll"},"dns":{"state":"active"},"auth":{"state":"invented"}}}`))
+	if facts["collection_received_at"] != "2020-01-01T00:00:00Z" || facts["collection_status"] != "recorded_snapshot" {
+		t.Fatal(facts)
+	}
+	states := facts["collection_states"].(map[string]string)
+	if len(states) != 2 || states["process"] != "degraded" || states["dns"] != "active" {
+		t.Fatal(states)
+	}
+	// 旧快照不改成当前时间，也不补写未报告组件。
+	if _, exists := states["file"]; exists {
+		t.Fatal(states)
+	}
+	facts["status"] = "ok"
+	raw, _ := json.Marshal(facts)
+	messages := []Message{{Role: "tool", Content: string(raw)}}
+	for _, tc := range []struct {
+		value string
+		valid bool
+	}{
+		{`{"process":"degraded","dns":"active"}`, true},
+		{`{"process":"active","dns":"active"}`, false},
+		{`{"process":"degraded","dns":"active","file":"disabled"}`, false},
+	} {
+		answer := strings.TrimSuffix(validVerdict, "}") + `,"evidence_claims":[{"evidence_id":"query-1","field":"collection_states","value":` + tc.value + `}]}`
+		_, err := bindEvidence(Message{Content: answer}, messages)
+		if (err == nil) != tc.valid {
+			t.Fatalf("%s: %v", tc.value, err)
+		}
+	}
+}
diff --git a/server/internal/triage/evaluation.go b/server/internal/triage/evaluation.go
new file mode 100644
index 0000000..2771f1e
--- /dev/null
+++ b/server/internal/triage/evaluation.go
@@ -0,0 +1,70 @@
+package triage
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"slices"
+)
+
+// EvidencePromptHash 标记离线评测实际使用的生产提示词，不包含模型配置或密钥。
+func EvidencePromptHash() string {
+	sum := sha256.Sum256([]byte(investigationPrompt()))
+	return hex.EncodeToString(sum[:])
+}
+
+// EvaluateSnapshot 仅评测给定证据快照的结论，不查生产库、不注册工具、不触发处置或通知。
+// 复用生产提示词与格式修复；调查工具和采集覆盖由单独的集成/实机测试验收。
+func EvaluateSnapshot(ctx context.Context, llm *LLM, evidence string, snapshots ...EvidenceSnapshot) (json.RawMessage, error) {
+	if err := ValidateEvidenceSnapshots(snapshots); err != nil {
+		return nil, err
+	}
+	e := &Engine{LLM: llm}
+	messages := []Message{{Role: "system", Content: investigationPrompt()}, {Role: "user", Content: "以下为离线证据快照，已附可用的调查结果。无法再查询；按现有证据和缺失范围作最终判断，不假设已经执行任何建议。\n" + evidence}}
+	var evidenceMessages []Message
+	for i, snapshot := range snapshots {
+		call := ToolCall{ID: fmt.Sprintf("snapshot-%d", i+1), Type: "function"}
+		call.Function.Name = snapshot.Tool
+		call.Function.Arguments = "{}"
+		evidenceMessages = append(evidenceMessages, Message{Role: "assistant", ToolCalls: []ToolCall{call}}, Message{Role: "tool", ToolCallID: call.ID, Content: string(snapshot.Result)})
+	}
+	if len(snapshots) > 0 {
+		raw, _ := json.Marshal(snapshots)
+		messages = append(messages, Message{Role: "user", Content: "离线工具结果快照：" + string(raw)})
+		ledger, _ := json.Marshal(queryEvidenceFrom(evidenceMessages))
+		messages = append(messages, Message{Role: "system", Content: "以下为离线回放的服务端证据台账，工具结果来自测试夹具，不代表本次实际执行。可引用其字段：" + string(ledger)})
+	}
+	msg, err := e.chat(ctx, messages, nil)
+	if err != nil {
+		return nil, err
+	}
+	answer, err := e.finishVerdictWithEvidence(ctx, messages, msg, evidenceMessages)
+	if err != nil {
+		return nil, err
+	}
+	return parseVerdict("offline-evaluation", answer), nil
+}
+
+// EvidenceSnapshot 是离线回放夹具，不是可由生产接口提交的工具结果。
+type EvidenceSnapshot struct {
+	Tool   string          `json:"tool"`
+	Result json.RawMessage `json:"result"`
+}
+
+func ValidateEvidenceSnapshots(snapshots []EvidenceSnapshot) error {
+	if len(snapshots) > 24 {
+		return fmt.Errorf("离线工具快照过多")
+	}
+	for _, snapshot := range snapshots {
+		if !slices.Contains([]string{"query_events", "process_lineage", "host_alerts", "process_baseline"}, snapshot.Tool) {
+			return fmt.Errorf("未知离线工具")
+		}
+		var result map[string]any
+		if len(snapshot.Result) > 128*1024 || json.Unmarshal(snapshot.Result, &result) != nil || result == nil {
+			return fmt.Errorf("离线工具结果必须是有界 JSON 对象")
+		}
+	}
+	return nil
+}
